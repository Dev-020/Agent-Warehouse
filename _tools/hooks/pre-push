#!/bin/sh
# warehouse pre-push hook v2 — installed by `warehouse install-hook`
# Blocks the push when `warehouse check` fails, or when a pushed branch tip holds an item whose
# content is not a release (`warehouse unreleased <tip>`). How the tip got there does not matter.
# Bypass with: git push --no-verify
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
zero=0000000000000000000000000000000000000000

if command -v python >/dev/null 2>&1; then py=python
elif command -v python3 >/dev/null 2>&1; then py=python3
else
  echo "pre-push: python not found; skipping warehouse checks" >&2
  exit 0
fi

echo "🔍 Pre-push validation..."

echo "  → warehouse check..."
if ! "$py" "$root/_tools/warehouse.py" check --json >/dev/null 2>&1; then
  echo "❌ warehouse check failed. Run 'warehouse check' for details."
  echo "   (Bypass with: git push --no-verify)"
  exit 1
fi

echo "  → Checking pushed branch tips for unreleased item changes..."
bad=0
# git passes one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue        # ref deletion
  case "$remote_ref" in refs/tags/*) continue ;; esac  # a tag is a release
  if ! out=$("$py" "$root/_tools/warehouse.py" unreleased "$local_sha" 2>&1); then
    echo "⚠️  $remote_ref ($(git rev-parse --short "$local_sha")) has items that are not released:"
    printf '%s\n' "$out" | grep -E '^  (unreleased|error) ' | sed 's/^/  /'
    printf '%s\n' "$out" | grep -qE '^  (unreleased|error) ' || printf '%s\n' "$out" | sed 's/^/    /'
    bad=1
  fi
done

if [ "$bad" -eq 1 ]; then
  echo ""
  echo "❌ Push blocked: item changes not released."
  echo "   Fix: release them with 'warehouse release <id> <major|minor|patch|initial>'."
  echo "   Bypass with: git push --no-verify (not recommended)"
  exit 1
fi

echo "✅ Pre-push validation passed"
exit 0
